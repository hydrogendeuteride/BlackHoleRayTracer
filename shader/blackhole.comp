//	Simplex 3D Noise
//	by Ian McEwan, Ashima Arts
//  https://gist.github.com/patriciogonzalezvivo/670c22f3966e662d2f83
vec4 permute(vec4 x){ return mod(((x*34.0)+1.0)*x, 289.0); }
vec4 taylorInvSqrt(vec4 r){ return 1.79284291400159 - 0.85373472095314 * r; }

float snoise(vec3 v)
{
    const vec2  C = vec2(1.0/6.0, 1.0/3.0);
    const vec4  D = vec4(0.0, 0.5, 1.0, 2.0);

    // First corner
    vec3 i  = floor(v + dot(v, C.yyy));
    vec3 x0 =   v - i + dot(i, C.xxx);

    // Other corners
    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min(g.xyz, l.zxy);
    vec3 i2 = max(g.xyz, l.zxy);

    //  x0 = x0 - 0. + 0.0 * C
    vec3 x1 = x0 - i1 + 1.0 * C.xxx;
    vec3 x2 = x0 - i2 + 2.0 * C.xxx;
    vec3 x3 = x0 - 1. + 3.0 * C.xxx;

    // Permutations
    i = mod(i, 289.0);
    vec4 p = permute(permute(permute(
    i.z + vec4(0.0, i1.z, i2.z, 1.0))
    + i.y + vec4(0.0, i1.y, i2.y, 1.0))
    + i.x + vec4(0.0, i1.x, i2.x, 1.0));

    // Gradients
    // ( N*N points uniformly over a square, mapped onto an octahedron.)
    float n_ = 1.0/7.0;// N=7
    vec3  ns = n_ * D.wyz - D.xzx;

    vec4 j = p - 49.0 * floor(p * ns.z *ns.z);//  mod(p,N*N)

    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_);// mod(j,N)

    vec4 x = x_ *ns.x + ns.yyyy;
    vec4 y = y_ *ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);

    vec4 b0 = vec4(x.xy, y.xy);
    vec4 b1 = vec4(x.zw, y.zw);

    vec4 s0 = floor(b0)*2.0 + 1.0;
    vec4 s1 = floor(b1)*2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));

    vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
    vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;

    vec3 p0 = vec3(a0.xy, h.x);
    vec3 p1 = vec3(a0.zw, h.y);
    vec3 p2 = vec3(a1.xy, h.z);
    vec3 p3 = vec3(a1.zw, h.w);

    //Normalise gradients
    vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x;
    p1 *= norm.y;
    p2 *= norm.z;
    p3 *= norm.w;

    // Mix final noise value
    vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m*m, vec4(dot(p0, x0), dot(p1, x1),
    dot(p2, x2), dot(p3, x3)));
}

vec3 toSpherical(vec3 pos)
{
    float rho = sqrt((pos.x * pos.x) + (pos.y * pos.y) + (pos.z * pos.z));
    float theta = atan(pos.z, pos.x);
    float phi = asin(pos.y /rho);
    return vec3(rho, theta, phi);
}

void sph_yup(vec3 pos, out float r, out float theta, out float phi, out float sinTheta)
{
    r = length(pos);
    float cy = clamp(pos.y / max(r, 1e-8), -1.0, 1.0);
    theta = acos(cy);
    sinTheta = sqrt(max(0.0, 1.0 - cy * cy));

    phi = atan(pos.z, pos.x);
}

float calculateRealisticTemperature(vec3 pos, float baseTemp)
{
    // Thin-disk profile (Shakura-Sunyaev / Novikov-Thorne inspired):
    // T(r) ∝ r^(-3/4). We define baseTemp as the temperature at innerRadius.
    float r = max(length(pos.xz), innerRadius);
    return baseTemp * pow(innerRadius / r, 0.75);
}

vec3 convertToRGB(float cX, float cY, float cZ, float normalized_cY) {
    float denom = cX + cY + cZ;
    float x = denom > 0.0 ? cX / denom : 0.0;
    float y = denom > 0.0 ? cY / denom : 0.0;
    float z = 1.0 - x - y;

    float X = x / y;
    float Y = 1.0;
    float Z = z / y;

    vec3 inputColor = vec3(X, Y, Z);
    vec3 outputColor = rec2020Transform * inputColor;

    float R = outputColor.r;
    float G = outputColor.g;
    float B = outputColor.b;

    R = max(R, 0.0);
    G = max(G, 0.0);
    B = max(B, 0.0);

    float maxVal = max(max(R, G), B);
    if (maxVal > 1.0) {
        float invMaxVal = 1.0 / maxVal;
        R *= invMaxVal;
        G *= invMaxVal;
        B *= invMaxVal;
    }

    return vec3(R, G, B) * normalized_cY;
}

vec3 getBlackbodyColor(float temperature, float redshiftFactor)
{
    float cX = 0.0;
    float cY = 0.0;
    float cZ = 0.0;
    float wavelength = 380.0;
    float adjustedTemperature = temperature / redshiftFactor;

    for (int i = 0; i < integrationNum; i++) {
        wavelength += 5.0;
        float lambda = wavelength * 1e-9;
        float intensity = ((2.0 * PlanckConstant * pow(LightSpeed, 2)) / pow(lambda, 5)) /
        (exp((PlanckConstant * LightSpeed) / (lambda * BoltzmannConstant * adjustedTemperature)) - 1.0);
        vec3 matchingFunc = matchingFunctions[i];
        cX += intensity * matchingFunc.x * 5.0;
        cY += intensity * matchingFunc.y * 5.0;
        cZ += intensity * matchingFunc.z * 5.0;
    }

    vec3 rgb = convertToRGB(cX, cY, cZ, 1.0);

    float tK = clamp(adjustedTemperature, 1000.0, 30000.0);
    float intensity = pow(tK / 6500.0, 4.0);

    return rgb * intensity;
}

vec4 computePhotonFourMomentum(vec3 pos, vec3 dir, bool useGR)
{
    float r, theta, phi, sinTheta;
    sph_yup(pos, r, theta, phi, sinTheta);

    vec3 er    = (r > 0.0) ? pos / r : vec3(0, 1, 0);
    vec3 ephi  = normalize(vec3(-sin(phi), 0.0, cos(phi)));
    vec3 etheta= normalize(vec3(cos(theta)*cos(phi), -sin(theta), cos(theta)*sin(phi)));

    vec3 d = normalize(dir);

    float vr = dot(d, er);
    float vth = dot(d, etheta);
    float vph = dot(d, ephi);

    float pr  = vr;
    float pth = vth / max(r, 1e-8);
    float pph = vph / max(r * max(sinTheta, 1e-6), 1e-8);

    float f = useGR ? (1.0 - 1.0 / max(r, 1.000001)) : 1.0;
    float spatial = (pr*pr)/max(f, 1e-8) + (r*r)*(pth*pth) + (r*r)*(sinTheta*sinTheta)*(pph*pph);
    float pt = sqrt(max(spatial / max(f, 1e-8), 0.0));

    return vec4(pt, pr, pth, pph);
}

float lorentzDot(vec4 a, vec4 b, vec3 pos, bool useGR)
{
    float r, theta, phi, sinTheta;
    sph_yup(pos, r, theta, phi, sinTheta);

    float f = useGR ? (1.0 - 1.0 / max(r, 1.000001)) : 1.0;

    return -f * a.x * b.x
    + (1.0 / max(f, 1e-8)) * a.y * b.y
    + (r*r) * a.z * b.z
    + (r*r) * (sinTheta*sinTheta) * a.w * b.w;
}

vec4 uStatic(vec3 pos, bool useGR)
{
    float r = length(pos);
    float f = useGR ? (1.0 - 1.0 / max(r, 1.000001)) : 1.0;
    float ut = inversesqrt(max(f, 1e-8));
    return vec4(ut, 0.0, 0.0, 0.0);
}

vec4 uDiskOrbit(vec3 pos, bool useGR)
{
    float r = length(pos);
    r = max(r, 1.500001);

    float ut;
    if (useGR) {
        ut = inversesqrt(max(1.0 - 1.5 / r, 1e-8));
    } else {
        float v = sqrt(0.5 / r);
        ut = inversesqrt(max(1.0 - v*v, 1e-8));
    }

    float Omega = sqrt(0.5 / (r*r*r));
    float uphi = ut * Omega;
    return vec4(ut, 0.0, 0.0, uphi);
}

float gFactor(vec3 pos, vec3 dir, bool useGR, bool useDoppler)
{
    vec4 p = computePhotonFourMomentum(pos, dir, useGR);

    vec4 u_em  = useDoppler ? uDiskOrbit(pos, useGR) : uStatic(pos, useGR);
    vec4 u_obs = uStatic(cameraPos, useGR);

    float w_em  = -lorentzDot(p, u_em, pos, useGR);
    float w_obs = -lorentzDot(p, u_obs, cameraPos, useGR);

    return w_obs / max(w_em, 1e-12);
}

float calculateDiskTurbulence(vec3 pos, float time)
{
    float r = length(vec2(pos.x, pos.z));
    float turbulence = 0.0;

    vec3 sphericalCoord = toSpherical(pos);

    float omega = sqrt(0.5 / max(r * r * r, 1e-6));
    float timeOffset = time * omega * diskSpeed;

    float amplitude = 1.0;
    float totalWeight = 0.0;

    for (int i = 0; i < diskNoiseLOD; i++)
    {
        float layerSpeed = ((i % 2) == 0) ? 1.0 : -0.7;
        float frequency = pow(2.0, float(i));

        float radialfactor = mix(0.5, 2.0, smoothstep(outerRadius, innerRadius * 1.2, r));
        float rotationOffset = timeOffset * layerSpeed;

        float heightEffect = 1.0 - 0.5 * smoothstep(0.0, diskHeight, abs(pos.y));

        vec3 turbCoord = vec3(
        sphericalCoord.x * frequency * radialfactor,
        (sphericalCoord.y + rotationOffset) * frequency,
        sphericalCoord.z * frequency + time * 0.07 * (0.5 + frequency) * layerSpeed
        );

        float noiseValue = snoise(turbCoord * diskNoiseScale);

        float weight = amplitude * heightEffect;
        turbulence += noiseValue * weight;
        totalWeight += weight;

        amplitude *= 0.5;
    }

    turbulence = turbulence / totalWeight;
    return turbulence * 0.5 + 0.5;
}

float getTurbulenceIntensity(float radius)
{
    float r_isco = 3.0;

    if (radius < innerRadius)
    {
        return 0.3 * smoothstep(0.0, innerRadius, radius);
    }
    else if (radius < r_isco * 2.0)
    {
        return 1.0;
    }
    else
    {
        return mix(1.0, 0.2, smoothstep(r_isco * 2.0, outerRadius, radius));
    }
}

float getTurbulenceTimeFactor(vec3 pos, float time)
{
    float r = length(vec2(pos.x, pos.z));
    float phi = atan(pos.z, pos.x);

    float slowFactor = sin(time * 0.1 + phi) * 0.5 + 0.5;

    float mediumFactor = sin(time * 0.3 + r * 0.5) * 0.5 + 0.5;

    float innerWeight = smoothstep(outerRadius, innerRadius * 2.0, r);

    return mix(mediumFactor, slowFactor, 1.0 - innerWeight);
}

float acceleration(float u)
{
    return -u * (1.0 - 1.5 * u);
}

void verlet(inout float u, inout float du, float dt)
{
    float ddu = acceleration(u);
    float u_new = u + du * dt + 0.5 * ddu * dt * dt;
    float ddu_new = acceleration(u_new);

    du += 0.5 * (ddu + ddu_new) * dt;
    u = u_new;
}

void rk4(inout float u, inout float du, float dt)
{
    float k1_u = du;
    float k1_du = acceleration(u);

    float k2_u = du + 0.5 * dt * k1_du;
    float k2_du = acceleration(u + 0.5 * dt * k1_u);

    float k3_u = du + 0.5 * dt * k2_du;
    float k3_du = acceleration(u + 0.5 * dt * k2_u);

    float k4_u = du + dt * k3_du;
    float k4_du = acceleration(u + dt * k3_u);

    u += (dt / 6.0) * (k1_u + 2.0 * k2_u + 2.0 * k3_u + k4_u);
    du += (dt / 6.0) * (k1_du + 2.0 * k2_du + 2.0 * k3_du + k4_du);
}

void shadeDiskSurface(vec3 p, vec3 rayDir, float ds, inout vec4 color, inout float Tr)
{
    vec3 d = rayDir / max(length(rayDir), 1e-8);

    float r = length(p.xz);

    float innerMask = smoothstep(innerRadius, innerRadius * 1.15, r);
    float outerMask = 1.0 - smoothstep(outerRadius * 0.98, outerRadius, r);
    float radialMask = innerMask * outerMask;
    if (radialMask <= 0.0) return;

    float h = diskHeight * mix(0.9, 1.8, smoothstep(innerRadius, outerRadius, r));

    float absY = abs(p.y);
    if (absY > h * 3.0) return;

    float vert = exp(-pow(absY, diskDensityV) / max(2.0 * h * h, 1e-6));

    float turb = calculateDiskTurbulence(p, time);          // 0..1
    float turbStrength = getTurbulenceIntensity(r);         // ~0.2..1
    float timeVar = getTurbulenceTimeFactor(p, time);       // 0..1

    float omega = sqrt(0.5 / max(r * r * r, 1e-6));
    float phi   = atan(p.z, p.x);
    float phiAdv = phi - time * omega * diskSpeed;

    float spiral = sin(phiAdv * 4.0 + r * 2.2) * 0.5 + 0.5; // 0..1

    float hotR = innerRadius * 1.35;
    float omegaHot = sqrt(0.5 / max(hotR * hotR * hotR, 1e-6));
    float phiHot = time * omegaHot * diskSpeed;
    float dPhi = atan(sin(phi - phiHot), cos(phi - phiHot));
    float hot = exp(-0.5 * pow((r - hotR) / 0.22, 2.0) - 0.5 * pow(dPhi / 0.35, 2.0));

    float emissMod = 1.0;
    emissMod *= mix(0.75, 1.35, turb);
    emissMod  = mix(1.0, emissMod, turbStrength);
    emissMod *= mix(0.90, 1.10, spiral);
    emissMod *= mix(0.92, 1.08, timeVar);
    emissMod += 0.75 * hot;
    emissMod  = clamp(emissMod, 0.2, 3.0);

    float rPeak  = innerRadius * 1.25;
    float rWidth = (outerRadius - innerRadius) * 0.12;
    float rho = exp(-0.5 * pow((r - rPeak) / max(rWidth, 1e-6), 2.0));

    float ringPuff = exp(-0.5 * pow((r - rPeak) / (rWidth * 1.6), 2.0));
    h *= mix(1.0, 1.6, ringPuff);

    rho *= smoothstep(innerRadius, innerRadius * 1.05, r);
    rho *= 1.0 - smoothstep(outerRadius * 0.98, outerRadius, r);

    rho *= pow(innerRadius / max(r, innerRadius), 0.6);

    if (rho < minDensity) return;

    float T = realisticTemperature ? calculateRealisticTemperature(p, accretionTemp) : accretionTemp;

    float g = 1.0;
    if (gravitationalRedShift || dopplerShift) {
        g = gFactor(p, d, gravitationalRedShift, dopplerShift);
    }

    vec3 bb = getBlackbodyColor(T * g, 1.0);
    float I = beaming ? pow(g, 3.0) : 1.0;

    float dsClamped = clamp(ds, 0.0, 0.25);

    //Beer-Lambert
    const float sigmaAbs      = 18.0;
    const float sourceBoost   = 6.5;

    float alpha = sigmaAbs * rho;
    float tau   = alpha * dsClamped;
    float trans = exp(-tau);

    vec3 S = bb * (sourceBoost * emissMod) * I;

    color.rgb += Tr * (1.0 - trans) * S;
    Tr *= trans;
}

vec4 rayMarch(vec3 pos, vec3 dir)
{
    vec4 color = vec4(0.0);
    float Tr = 1.0;

    float yPrev = pos.y;
    vec3 prev_pos = pos;

    float u = 1.0 / length(pos);
    vec3  n = normalize(pos);

    vec3 dirN = normalize(dir);
    vec3 t = dirN - dot(dirN, n) * n; // tangential component
    float tLen = length(t);
    if (tLen < 1e-6)
    {
        vec3 a = (abs(n.y) < 0.9) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        t = normalize(cross(a, n));
        tLen = 1.0;
    }
    else
    {
        t /= tLen;
    }

    float du = -dot(n, dirN) / max(dot(dirN, t), 1e-6) * u;
    float phi = 0.0;

    float maxPhi = float(maxTurns) * 2.0 * PI;

    const float rHorizon = 1.0;
    const float uEscape  = 1.0 / 60.0;

    for (int i = 0; i < iteration; ++i)
    {
        float stiff = max(1e-3, abs(1.0 - 1.5 * u));
        float dt = clamp(steps / stiff, steps*0.25, steps*4.0);

        (integrationType == 0) ? verlet(u, du, dt) : rk4(u, du, dt);
        if (u < 0.0) break;

        if (u >= (1.0 / rHorizon))
        {
            Tr = 0.0;
            break;
        }

        phi += dt;
        if (phi > maxPhi) break;

        vec3 old = pos;
        pos = (cos(phi) * n + sin(phi) * t) / u;
        vec3 seg = pos - old;
        float ds = length(seg);
        dir = seg;

        vec3 mid = 0.5 * (old + pos);

        if (u < uEscape) break;


        float rXZ = length(pos.xz);
        bool inRadial = (rXZ >= innerRadius) && (rXZ <= outerRadius);

        if (disk && inRadial && abs(mid.y) <= diskHeight * 3.0)
        {
            shadeDiskSurface(mid, seg, ds, color, Tr);
        }

        yPrev = pos.y;
        prev_pos = pos;
        if (Tr < 1e-3) break;
    }

    color.rgb += Tr * texture(cubemap, normalize(dir)).rgb;
    return vec4(color.rgb, 1.0);
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    if (pixelCoord.x >= resolution.x || pixelCoord.y >= resolution.y)
    return;

    vec2 uv = (2.0 * vec2(pixelCoord) - resolution) / resolution.y;

    vec3 dirCam = normalize(vec3(uv, -1.0));

    mat4 invView = inverse(view);
    vec3 dirWorld = (invView * vec4(dirCam, 0.0)).xyz;
    dirWorld = normalize(dirWorld);

    vec3 posWorld = (invView * vec4(0, 0, 0, 1)).xyz;

    vec4 fragColor = rayMarch(posWorld, dirWorld);

    imageStore(outputImage, pixelCoord, fragColor);
}
